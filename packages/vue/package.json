{
  "name": "@formle/vue",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ladown/formle.git",
    "directory": "packages/vue"
  },
  "files": ["dist"],
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "release": "semantic-release"
  },
  "dependencies": {
    "@formle/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vue/test-utils": "2.4.10",
    "happy-dom": "20.9.0",
    "unplugin-vue": "7.2.0",
    "vitest": "4.1.6",
    "vue": "3.5.34"
  }
}
